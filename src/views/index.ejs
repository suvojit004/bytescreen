<%- include("partials/header") %>
<%- include("partials/nav") %>

  <main id="main">
    <!-- Hero -->
    <section class="hero enterprise-hero" id="top">
      <img class="hero-media" src="/images/firewall-demo.png" alt="" width="1672" height="941" fetchpriority="high" />
      <div class="wrap hero-inner">
        <p class="kicker">SECURE NETWORKS. STRONGER BUSINESSES.</p>
        <h1>Your network.<br />Your advantage.<br /><span>Secured.</span></h1>
        <p class="lead">Move your business forward with confidence. Bring security, connectivity and control together with Bytescreen.</p>
        <div class="actions">
          <a class="button" href="/demo">Get a live demo <span aria-hidden="true">→</span></a>
          <a class="button button-ghost" href="#solutions">Explore our solutions</a>
        </div>
      </div>
      <div class="hero-caption"><span aria-hidden="true"></span> Protection at every connection</div>
    </section>
    <section class="trust-strip" aria-label="Why Bytescreen">
      <div class="wrap">
        <ul class="status-panel" aria-label="Why organisations choose Bytescreen">
          <li class="status-item"><div><b><%= customerCount %>+ <small>organisations</small></b><span>Connecting enterprises across India</span></div></li>
          <li class="status-item"><div><b>ISO <small>certified</small></b><span>9001 · 20000-1 · 27001</span></div></li>
          <li class="status-item"><div><b>24/7 <small>expert support</small></b><span>Real people. Ready when you need us.</span></div></li>
        </ul>
      </div>
    </section>

    <!-- Solutions -->
    <section class="section solutions" id="solutions">
      <div class="wrap">
        <div class="section-head">
          <div><p class="eyebrow">THE BYTESCREEN PORTFOLIO</p><h2>One connected business.<br />Every layer protected.</h2></div>
          <p class="intro">From branch connectivity to policy control, Bytescreen brings critical network services into one manageable, business-ready environment.</p>
        </div>
        <%
          // Solutions cards. "Explore" appears only when the product has a published page
          // (published products come from the database via navMenu, the same list as the nav).
          const solutions = [
            { name: "BT-NGFW", key: "bt-ngfw", text: "Secure users, applications and network edges with next-generation firewall capabilities designed for evolving threats." },
            { name: "BT-WAN", key: "bt-wan", text: "Deliver stable, high-performing connectivity across sites with intelligent routing and flexible WAN management." },
            { name: "BT-AAA", key: "bt-aaa", text: "Control who gets on your network and what they can reach, with centralised authentication, authorisation and accounting." },
            { name: "BT-Load Balancer", key: "bt-load-balancer", text: "Keep applications fast and available by distributing traffic intelligently, so no single link or server becomes a bottleneck." },
          ];
          const menu = locals.navMenu || { products: [], platform: [] };
          const publishedKeys = new Set(menu.products.concat(menu.platform).map((product) => product.key));
        %>
        <div class="services">
          <% solutions.forEach((solution, index) => { %>
          <article class="service">
            <div class="solution-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <% if (index === 0) { %><path d="M24 4 40 10v13c0 10-8 17-16 21C16 40 8 33 8 23V10Z"/><path d="m16 24 5 5 11-12"/><% } %>
                <% if (index === 1) { %><rect x="16" y="16" width="16" height="16" rx="2"/><path d="M24 16V7m0 25v9M16 24H7m25 0h9"/><circle cx="24" cy="5" r="3"/><circle cx="24" cy="43" r="3"/><circle cx="5" cy="24" r="3"/><circle cx="43" cy="24" r="3"/><% } %>
                <% if (index === 2) { %><circle cx="24" cy="15" r="8"/><path d="M8 42v-5c0-8 7-12 16-12s16 4 16 12v5Z"/><path d="m19 35 4 4 7-8"/><% } %>
                <% if (index === 3) { %><rect x="4" y="17" width="12" height="14" rx="2"/><rect x="32" y="4" width="12" height="12" rx="2"/><rect x="32" y="32" width="12" height="12" rx="2"/><path d="M16 24h9V10h7M25 24v14h7"/><% } %>
              </svg>
            </div>
            <p class="solution-category"><%= ['NEXT-GENERATION FIREWALL', 'SOFTWARE-DEFINED WAN', 'IDENTITY & ACCESS', 'APPLICATION DELIVERY'][index] %></p>
            <h3><%= solution.name %></h3>
            <p><%= solution.text %></p>
            <div class="service-actions">
              <% if (publishedKeys.has(solution.key)) { %>
              <a class="button button-sm" href="/products/<%= solution.key %>">Explore <%= solution.name %></a>
              <% } %>
              <a class="textlink" href="mailto:sales@bytescreentech.com?subject=<%= encodeURIComponent(solution.name + ' enquiry') %>">Ask about <%= solution.name %></a>
            </div>
          </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Demo video -->
    <section class="section demo" id="demo">
      <div class="wrap demo-grid">
        <div class="demo-copy">
          <p class="eyebrow">SECURITY IN ACTION</p>
          <h2>See the firewall at work.</h2>
          <p class="intro">A short look at how Bytescreen inspects traffic, applies policy and keeps your network edge protected.</p>
          <a class="textlink textlink-light" href="/demo">Book a live walkthrough</a>
        </div>
        <figure class="screen">
          <video data-demo-video autoplay muted loop playsinline controls preload="metadata" poster="/images/firewall-demo.png" aria-label="Bytescreen firewall demonstration">
            <source src="/videos/bytescreen-demo.mp4" type="video/mp4" />
            Your browser can't play this video. <a href="/videos/bytescreen-demo.mp4">Download the demo</a>.
          </video>
        </figure>
      </div>
    </section>

    <!-- Offers -->
    <section class="section offers" id="offers">
      <div class="wrap">
        <div class="section-head">
          <h2>More than protection. Momentum for your business.</h2>
          <p class="intro">A network foundation that keeps your business secure, connected and ready for what comes next.</p>
        </div>
        <div class="offer-list">
          <article class="offer">
            <div class="offer-text">
              <h3>Innovation at its core</h3>
              <p>We keep pushing the boundaries of network technology, bringing you the latest advancements so your business stays ahead of the curve.</p>
            </div>
            <img src="/images/offer-innovation.png" alt="" loading="lazy" width="1672" height="164" />
          </article>
          <article class="offer">
            <div class="offer-text">
              <h3>Security as a commitment</h3>
              <p>Security isn't a feature for us. We put robust measures in place to protect your data and digital assets against evolving threats.</p>
            </div>
            <img src="/images/offer-security.png" alt="" loading="lazy" width="1672" height="174" />
          </article>
          <article class="offer">
            <div class="offer-text">
              <h3>Seamless connectivity</h3>
              <p>Connect people, devices and processes across every site, so collaboration and productivity never wait on the network.</p>
            </div>
            <img src="/images/offer-connectivity.png" alt="" loading="lazy" width="1672" height="173" />
          </article>
          <article class="offer">
            <div class="offer-text">
              <h3>Cost-effective by design</h3>
              <p>Our solutions are built to raise efficiency while keeping expenses down, giving you a practical route to your business goals.</p>
            </div>
            <img src="/images/offer-value.png" alt="" loading="lazy" width="1672" height="188" />
          </article>
          <article class="offer">
            <div class="offer-text">
              <h3>Support around the clock</h3>
              <p>Our commitment continues long after implementation. A dedicated team of experts is available 24/7 whenever you need help.</p>
            </div>
            <img src="/images/offer-support.png" alt="" loading="lazy" width="1672" height="213" />
          </article>
        </div>
      </div>
    </section>

    <!-- Platform -->
    <section class="section platform" id="platform">
      <div class="wrap platform-grid">
        <div class="platform-copy">
          <p class="eyebrow">A CONNECTED FOUNDATION</p>
          <h2>Less complexity. More control.</h2>
          <p class="intro">Bytescreen brings security, connectivity and visibility together for IT teams, without adding another layer of operational burden.</p>
          <a class="button button-light" href="mailto:sales@bytescreentech.com?subject=Bytescreen%20platform%20enquiry">See how it fits your network</a>
        </div>
        <div class="rack" aria-label="The Bytescreen foundation, in three layers">
          <div class="rack-unit">
            <span class="unit-leds" aria-hidden="true"><i></i><i></i></span>
            <div><b>Protect</b><span>every network edge</span></div>
            <span class="unit-vent" aria-hidden="true"></span>
          </div>
          <div class="rack-unit">
            <span class="unit-leds" aria-hidden="true"><i></i><i></i></span>
            <div><b>Connect</b><span>every location</span></div>
            <span class="unit-vent" aria-hidden="true"></span>
          </div>
          <div class="rack-unit">
            <span class="unit-leds" aria-hidden="true"><i></i><i></i></span>
            <div><b>Manage</b><span>from one clear view</span></div>
            <span class="unit-vent" aria-hidden="true"></span>
          </div>
          <div class="outcomes">
            <div>
              <h3>Security that stays practical</h3>
              <p>Protection, policy and performance in the places your business depends on.</p>
            </div>
            <div>
              <h3>Operations that stay agile</h3>
              <p>Less friction as your network, teams and priorities change.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Bytescreen -->
    <section class="section why" id="why">
      <div class="wrap why-grid">
        <figure class="why-media">
          <img src="/images/security-operations-demo.png" alt="Built for smarter, safer growth: designed for growth, security and networking in one conversation, a practical path to ongoing improvement, and support from a team that's ready 24/7" loading="lazy" width="1122" height="1402" />
        </figure>
        <div class="why-copy">
          <h2>Technology that keeps momentum on your side.</h2>
          <p class="intro">Our focus is simple: make enterprise networking more secure, scalable and cost-effective for the organisations that rely on it every day.</p>
          <ul class="checks">
            <li>Designed for growth, from a single site to a connected estate</li>
            <li>Security and networking handled in one conversation</li>
            <li>A practical path to ongoing network improvement</li>
            <li>Support from a team that's ready 24/7</li>
          </ul>
          <blockquote class="quote">
            <p>Secure connectivity should feel like an advantage, not another operational challenge.</p>
            <footer>Bytescreen Tech</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section class="section approach" id="approach">
      <div class="wrap">
        <div class="section-head">
          <h2>Secure networking, made simpler.</h2>
          <p class="intro">A way of working built around your people, your operations and your business goals.</p>
        </div>
        <div class="reasons">
          <article class="reason">
            <h3>Easy to use</h3>
            <p>Our solutions are designed to be accessible to every level of expertise, not just specialists.</p>
          </article>
          <article class="reason">
            <h3>Swift implementation</h3>
            <p>An efficient rollout process that keeps disruption to your business operations to a minimum.</p>
          </article>
          <article class="reason">
            <h3>Continuous improvement</h3>
            <p>As technology evolves, we adapt your network to stay ahead of threats and maximise performance.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Customers & standards -->
    <section class="section customers" id="customers">
      <div class="wrap">
        <div class="section-head">
          <h2>Building resilient networks together.</h2>
          <div>
            <p class="intro">Organisations across India rely on Bytescreen for dependable network security and connectivity.</p>
            <a class="textlink" href="/customers">See all our customers</a>
          </div>
        </div>
        <ul class="logo-wall">
          <li class="client-logo" data-name="Wellstore"><img src="https://www.bytescreentech.com/wp-content/uploads/elementor/thumbs/wellsttore-r1rvewixr3ana869wo050fhynu91av5xpl8banpclq.png" alt="Wellstore" loading="lazy" /></li>
          <li class="client-logo" data-name="Acquisory"><img src="https://www.bytescreentech.com/wp-content/uploads/elementor/thumbs/acquisory-r1rveun9df82n0907n6vvfz1h2iavgyh1bxcc3s4y6.png" alt="Acquisory" loading="lazy" /></li>
          <li class="client-logo" data-name="TIPL"><img src="https://www.bytescreentech.com/wp-content/uploads/elementor/thumbs/tipl-r2d2fd6v2rjtoap6dk71ecy13noyza23xuw6w1xury.png" alt="TIPL" loading="lazy" /></li>
          <li class="client-logo" data-name="Altus"><img src="https://www.bytescreentech.com/wp-content/uploads/elementor/thumbs/altus-1-r1rveun9df82n0907n6vvfz1h2iavgyh1bxcc3s4y6.png" alt="Altus" loading="lazy" /></li>
          <li class="client-logo" data-name="JV Ventures"><span>JV Ventures</span></li>
          <li class="client-logo" data-name="Jaypee Group"><img src="https://www.bytescreentech.com/wp-content/uploads/elementor/thumbs/JAYPEE-GROUP-CLIENT-LOGOS-rg8ubz4z4tt34vt00o5kwuj340eegzcaltpxf3xfda.png" alt="Jaypee Group" loading="lazy" /></li>
          <li class="client-logo" data-name="Krypton Industries"><img src="https://www.bytescreentech.com/wp-content/uploads/elementor/thumbs/KRYPTON-INDUSTRIES-CLIENT-LOGOS-rg8uialx2qgh6iml4ehao94mv9987qfc53lfk2k5ji.png" alt="Krypton Industries" loading="lazy" /></li>
          <li class="client-logo" data-name="Bihar Sarkar"><img src="https://www.bytescreentech.com/wp-content/uploads/elementor/thumbs/BIHAR-SARKAR-rg8vo0o0fzkoje0rhfr4cq384zlrw22ejm3cg8p1ce.jpg" alt="Bihar Sarkar" loading="lazy" /></li>
        </ul>
        <div class="certs">
          <p class="certs-label">Certified for quality and information security</p>
          <div class="cert"><b>ISO 9001</b><span>Quality management</span></div>
          <div class="cert"><b>ISO 27001</b><span>Information security</span></div>
          <div class="cert"><b>ISO 20000-1</b><span>IT Service Management</span></div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta">
      <div class="wrap cta-inner">
        <h2>Ready to build a stronger network foundation?</h2>
        <div class="cta-actions">
          <a class="button button-light" href="/demo">Schedule a demo</a>
          <a class="cta-phone" href="tel:+918369071774">or call +91 836 907 1774</a>
        </div>
      </div>
    </section>
  </main>

<%- include("partials/footer") %>
