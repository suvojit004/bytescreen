<%- include("partials/header") %>
<%- include("partials/nav") %>

  <main id="main">
    <!-- Page hero -->
    <section class="page-hero" id="top">
      <div class="wrap">
        <nav class="kicker breadcrumb" aria-label="Breadcrumb"><a href="/resources">Resources</a><span aria-hidden="true">/</span><span aria-current="page"><%= page.name %></span></nav>
        <h1><%= page.heading %></h1>
        <p class="lead"><%= page.intro %></p>
      </div>
    </section>

    <% if (documentGroups.length) { %>
    <!-- Downloadable documents (read from src/public/resources/<folder>) -->
    <% documentGroups.forEach((group) => { %>
    <section class="section doc-section" id="<%= group.id %>">
      <div class="wrap">
        <div class="group-head">
          <div>
            <h2><%= group.title %></h2>
            <% if (group.intro) { %><p class="intro doc-intro"><%= group.intro %></p><% } %>
          </div>
          <span class="group-count"><%= group.items.length %> <%= group.itemLabel || "document" %><%= group.items.length === 1 ? "" : "s" %></span>
        </div>
        <ul class="doc-grid">
          <% group.items.forEach((doc) => { %>
          <li>
            <a class="doc-card" href="<%= doc.url %>" download="<%= doc.fileName %>">
              <span class="doc-icon" aria-hidden="true">PDF</span>
              <span class="doc-title"><%= doc.title %></span>
              <span class="doc-action">Download<span class="sr-only"> <%= doc.title %> (PDF)</span></span>
            </a>
          </li>
          <% }) %>
        </ul>
      </div>
    </section>
    <% }) %>

    <!-- Support -->
    <section class="section doc-help">
      <div class="wrap coming-soon">
        <div>
          <p class="eyebrow">Need help?</p>
          <h2>Can’t find what you’re looking for?</h2>
          <p class="intro">Browse <a class="textlink-inline" href="/resources">all resources</a>, or contact our support team, available 24/7 to help with any question.</p>
        </div>
        <%- include("partials/support-contacts") %>
      </div>
    </section>
    <% } else { %>
    <!-- Placeholder until documents are added -->
    <section class="section">
      <div class="wrap coming-soon">
        <div>
          <p class="eyebrow">Coming soon</p>
          <h2>We’re putting this section together.</h2>
          <p class="intro">Articles will appear here shortly. In the meantime, our support team is available 24/7 to help with any question.</p>
        </div>
        <%- include("partials/support-contacts") %>
      </div>
    </section>
    <% } %>
  </main>

<%- include("partials/footer") %>
