<%#
  Sales / demo enquiry form, posted to the leads API (POST /leads).
  Locals: products, inquiryTypes, successText, submitLabel, messageLabel
%>
<%
  const inquiryLabels = {
    demo: "Book a demo",
    consultation: "Consultation",
    quote: "Request a quote",
    general: "General enquiry",
  };
%>
<form class="contact-form" action="/leads" method="post" data-ajax-form data-success="<%= successText %>" novalidate>
  <div class="field-row">
    <div class="field">
      <label for="firstName">First name <abbr title="required">*</abbr></label>
      <input id="firstName" name="firstName" type="text" autocomplete="given-name" required minlength="2" />
    </div>
    <div class="field">
      <label for="lastName">Last name</label>
      <input id="lastName" name="lastName" type="text" autocomplete="family-name" />
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="email">Work email <abbr title="required">*</abbr></label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="phone">Phone <abbr title="required">*</abbr></label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" required pattern="[+0-9 \(\)\-]{7,20}" />
    </div>
  </div>
  <div class="field">
    <label for="company">Company <abbr title="required">*</abbr></label>
    <input id="company" name="company" type="text" autocomplete="organization" required minlength="2" />
  </div>
  <div class="field-row">
    <div class="field">
      <label for="product">Product <abbr title="required">*</abbr></label>
      <select id="product" name="product" required>
        <option value="">Select a product</option>
        <% products.forEach((product) => { %>
        <option value="<%= product %>"><%= product %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="inquiryType">I’d like to</label>
      <select id="inquiryType" name="inquiryType">
        <% inquiryTypes.forEach((type) => { %>
        <option value="<%= type %>"><%= inquiryLabels[type] || type %></option>
        <% }) %>
      </select>
    </div>
  </div>
  <div class="field">
    <label for="message"><%= messageLabel %> <abbr title="required">*</abbr></label>
    <textarea id="message" name="message" rows="5" required minlength="10"></textarea>
  </div>
  <div class="form-foot">
    <button class="button" type="submit"><%= submitLabel %></button>
    <p class="form-status" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>
