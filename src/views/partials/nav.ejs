<%
  // Products shown in the nav dropdown; each links to /products/<key>
  const navProducts = [
    { name: "BT-NGFW", key: "bt-ngfw", summary: "Next-generation firewall" },
    { name: "BT-WAN", key: "bt-wan", summary: "SD-WAN connectivity across sites" },
    { name: "BT-AAA", key: "bt-aaa", summary: "Authentication, authorisation and accounting" },
  ];
  // Shown under a separate "Platform" heading in the same dropdown
  const navPlatform = [
    { name: "FusionM", key: "fusionm", summary: "Centralised controller for every device" },
  ];
  const onProductPage = path.startsWith("/products/");

  // Resources dropdown; each links to /resources/<key>
  const navResources = [
    { name: "Knowledge base", key: "knowledge-base", summary: "Guides, how-tos and product documentation" },
    { name: "Troubleshooting", key: "troubleshooting", summary: "Fixes for common issues and error messages" },
  ];
  const onResourcePage = path === "/resources" || path.startsWith("/resources/");
%>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" data-header>
    <div class="wrap nav">
      <%- include("logo") %>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="menu-bar" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
      <nav class="navlinks" id="site-nav" aria-label="Main">
        <div class="nav-dropdown" data-dropdown>
          <button class="dropdown-toggle<%= onProductPage ? ' is-current' : '' %>" type="button" aria-expanded="false" aria-controls="products-menu" data-dropdown-toggle>
            Products<span class="caret" aria-hidden="true"></span>
          </button>
          <ul class="dropdown-menu" id="products-menu">
            <% navProducts.concat(navPlatform).forEach((product, i) => { %>
            <% if (i === navProducts.length) { %>
            <li class="dropdown-heading" aria-hidden="true">Platform</li>
            <% } %>
            <li>
              <a href="/products/<%= product.key %>"<%- path === "/products/" + product.key ? ' aria-current="page"' : "" %>>
                <b><%= product.name %></b>
                <span><%= product.summary %></span>
              </a>
            </li>
            <% }) %>
          </ul>
        </div>
        <a href="/about"<%- path === "/about" ? ' aria-current="page"' : "" %>>Company</a>
        <a href="/customers"<%- path === "/customers" ? ' aria-current="page"' : "" %>>Customers</a>
        <a href="/partner"<%- path === "/partner" ? ' aria-current="page"' : "" %>>Partners</a>
        <div class="nav-dropdown" data-dropdown>
          <button class="dropdown-toggle<%= onResourcePage ? ' is-current' : '' %>" type="button" aria-expanded="false" aria-controls="resources-menu" data-dropdown-toggle>
            Resources<span class="caret" aria-hidden="true"></span>
          </button>
          <ul class="dropdown-menu" id="resources-menu">
            <% navResources.forEach((resource) => { %>
            <li>
              <a href="/resources/<%= resource.key %>"<%- path === "/resources/" + resource.key ? ' aria-current="page"' : "" %>>
                <b><%= resource.name %></b>
                <span><%= resource.summary %></span>
              </a>
            </li>
            <% }) %>
            <li class="dropdown-footer">
              <a href="/resources"<%- path === "/resources" ? ' aria-current="page"' : "" %>><b>View all resources →</b></a>
            </li>
          </ul>
        </div>
        <a href="/contact"<%- path === "/contact" ? ' aria-current="page"' : "" %>>Contact</a>
        <a class="button button-sm button-ghost nav-login" href="<%= controllerUrl %>">FusionMaestro login</a>
        <a class="button button-sm" href="/demo"<%- path === "/demo" ? ' aria-current="page"' : "" %>>Schedule a demo</a>
      </nav>
    </div>
  </header>
