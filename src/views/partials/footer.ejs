  <footer class="footer">
    <div class="wrap footgrid">
      <div class="foot-brand">
        <%- include("logo", { large: true }) %>
        <p>Secure, connect and manage the network your business depends on.</p>
        <address>DLF Galleria, 312, Major Arterial Road<br />(South East Extension), BG Block (Newtown),<br />Action Area I, New Town, Kolkata,<br />West Bengal 700163</address>
      </div>
      <div>
        <h4>Products</h4>
        <%
          // Published products from the database (same list as the nav's Products menu)
          const footerMenu = locals.navMenu || { products: [], platform: [] };
          const footerProducts = footerMenu.products.concat(footerMenu.platform);
        %>
        <ul>
          <% if (footerProducts.length) { %>
          <% footerProducts.forEach((product) => { %>
          <li><a href="/products/<%= product.key %>"><%= product.name %></a></li>
          <% }) %>
          <% } else { %>
          <li><a href="/#solutions">Our solutions</a></li>
          <% } %>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/#why">Why Bytescreen</a></li>
          <li><a href="/about">About us</a></li>
          <li><a href="/customers">Our customers</a></li>
          <li><a href="/partner">Partner with us</a></li>
          <li><a href="/resources">Resources</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:sales@bytescreentech.com">sales@bytescreentech.com</a></li>
          <li><a href="tel:+918369071774">+91 836 907 1774</a></li>
          <li><a href="/contact#support">Customer support</a></li>
          <li><a href="/contact#sales">Talk to sales</a></li>
          <li><a href="<%= controllerUrl %>">FusionMaestro login</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap copyright">
      <span>&copy; <span data-year><%= year %></span> Bytescreen Tech. All rights reserved.</span>
      <span class="legal-links">
        <a href="/privacy">Privacy policy</a>
        <a href="/terms">Terms and conditions</a>
        <span>ISO 9001, ISO 20000-1 and ISO 27001 certified</span>
      </span>
    </div>
  </footer>

  <a class="button mobile-demo" href="/demo">Schedule a demo</a>

  <script src="/js/script.js" defer></script>
</body>
</html>
