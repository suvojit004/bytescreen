<%- include("partials/header") %>
<%- include("partials/nav") %>

<%
  const inquiryLabels = {
    demo: "Book a demo",
    consultation: "Consultation",
    quote: "Request a quote",
    general: "General enquiry",
  };
%>
  <main id="main">
    <!-- Page hero -->
    <section class="page-hero" id="top">
      <div class="wrap">
        <p class="kicker">Contact us</p>
        <h1>Let’s talk about your network.</h1>
        <p class="lead">Planning something new, or need help with a network you already run on Bytescreen? Choose the team that fits your query and we’ll take it from there.</p>
      </div>
      <div class="wrap">
        <div class="route-cards">
          <a class="route-card" href="#sales">
            <span class="route-label">Sales</span>
            <b>Explore Bytescreen for your business</b>
            <span>Demos, consultations, pricing and quotes</span>
          </a>
          <a class="route-card" href="#support">
            <span class="route-label route-label-ok">Support</span>
            <b>Get help with an existing deployment</b>
            <span>Our experts are available 24/7</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Sales -->
    <section class="section contact-sales" id="sales">
      <div class="wrap contact-grid">
        <div class="contact-copy">
          <p class="eyebrow">Sales enquiries</p>
          <h2>Find the right fit for your network.</h2>
          <p class="intro">Tell us about your sites, your users and what you want to achieve. Our team will get back to you to plan a demo, a consultation or a quote.</p>
          <ul class="contact-list">
            <li>
              <span>Email</span>
              <a href="mailto:sales@bytescreentech.com">sales@bytescreentech.com</a>
            </li>
            <li>
              <span>Phone</span>
              <a href="tel:+918369071774">+91 836 907 1774</a>
            </li>
          </ul>
        </div>

        <form class="contact-form" action="/leads" method="post" data-ajax-form data-success="Thank you. Our sales team will be in touch shortly." novalidate>
          <div class="field-row">
            <div class="field">
              <label for="firstName">First name <abbr title="required">*</abbr></label>
              <input id="firstName" name="firstName" type="text" autocomplete="given-name" required minlength="2" />
            </div>
            <div class="field">
              <label for="lastName">Last name</label>
              <input id="lastName" name="lastName" type="text" autocomplete="family-name" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="email">Work email <abbr title="required">*</abbr></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="phone">Phone <abbr title="required">*</abbr></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" required pattern="[+0-9 \(\)\-]{7,20}" />
            </div>
          </div>
          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" autocomplete="organization" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="product">Product <abbr title="required">*</abbr></label>
              <select id="product" name="product" required>
                <option value="">Select a product</option>
                <% products.forEach((product) => { %>
                <option value="<%= product %>"><%= product %></option>
                <% }) %>
              </select>
            </div>
            <div class="field">
              <label for="inquiryType">I’d like to</label>
              <select id="inquiryType" name="inquiryType">
                <% inquiryTypes.forEach((type) => { %>
                <option value="<%= type %>"><%= inquiryLabels[type] || type %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="message">How can we help? <abbr title="required">*</abbr></label>
            <textarea id="message" name="message" rows="5" required minlength="10"></textarea>
          </div>
          <div class="form-foot">
            <button class="button" type="submit">Send to sales</button>
            <p class="form-status" role="status" aria-live="polite" data-form-status></p>
          </div>
        </form>
      </div>
    </section>

    <!-- Support -->
    <section class="section contact-support" id="support">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow eyebrow-light">Customer support</p>
            <h2>Already a customer? We’re here around the clock.</h2>
          </div>
          <p class="intro">Our support team is available 24/7 for help with your Bytescreen firewall, SD-WAN or managed network services.</p>
        </div>

        <div class="support-grid">
          <a class="support-card" href="mailto:support@bytescreentech.com?subject=Support%20request">
            <span class="support-label">Email support</span>
            <b>support@bytescreentech.com</b>
            <span>Best for detailed issues, logs and screenshots</span>
          </a>
          <a class="support-card" href="tel:+918369071774">
            <span class="support-label">Call us</span>
            <b>+91 836 907 1774</b>
            <span>Best for urgent issues affecting your network</span>
          </a>
          <div class="support-card support-card-status">
            <span class="support-label"><span class="led led-on" aria-hidden="true"></span>Availability</span>
            <b>24 hours, 7 days</b>
            <span>Experts on call, including weekends and holidays</span>
          </div>
        </div>

        <div class="support-help">
          <h3>Help us resolve it faster</h3>
          <ul class="checks checks-light">
            <li>Your company name and the site or location affected</li>
            <li>The product involved: network security, SD-WAN or NaaS</li>
            <li>What happened, when it started and what has changed</li>
            <li>Any error messages, logs or screenshots you have</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Office -->
    <section class="section office">
      <div class="wrap office-grid">
        <h2>Visit our office.</h2>
        <address class="office-address">
          <b>Bytescreen Tech Pvt. Ltd.</b>
          DLF Galleria, 312, Major Arterial Road<br />
          (South East Extension), BG Block (Newtown),<br />
          Action Area I, New Town, Kolkata,<br />
          West Bengal 700163
        </address>
      </div>
    </section>
  </main>

  <script src="/js/form.js" defer></script>
<%- include("partials/footer") %>
