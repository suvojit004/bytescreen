# Copy to .env.production on the VPS and set a long, random secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# The base domain; the www hostname is routed automatically.
DOMAIN=example.com

# Match the certificate resolver configured in Traefik.
TRAEFIK_CERT_RESOLVER=letsencrypt

CONTROLLER_URL=https://fusionm.bytescreentech.com
