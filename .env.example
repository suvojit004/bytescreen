# Copy to .env on the VPS and set strong, unique secrets.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Use URL-safe hex passwords (for example, generate with: openssl rand -hex 32).
MONGO_ROOT_USER=bytescreen_root
MONGO_ROOT_PASSWORD=replace-with-a-long-random-hex-secret
MONGO_APP_USER=bytescreen_app
MONGO_APP_PASSWORD=replace-with-a-long-random-hex-secret
MONGO_URI=mongodb://bytescreen_app:replace-with-a-long-random-hex-secret@mongodb:27017/bytescreen?authSource=bytescreen

# Optional comma-separated browser origins needing cross-origin API access.
CORS_ALLOW_ORIGINS=

# The base domain; the www hostname is routed automatically.
DOMAIN=example.com

# Match the certificate resolver configured in Traefik.
TRAEFIK_CERT_RESOLVER=letsencrypt

CONTROLLER_URL=https://fusionm.bytescreentech.com
